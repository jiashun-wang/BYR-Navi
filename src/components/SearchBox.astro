---
import site from '../data/site';
import searchServices from '../data/search_services.json';
import Banner from './Banner.astro';
---

<div class="ui text container">
    <Banner />
    <h1 class="ui inverted logo header">
        <img class="ui centered image" src={site.logoWhite} alt="Logo" />
    </h1>
    <h2 class="ui inverted header">{site.title}</h2>
    <div id="search-shortcuts" class="ui mini labels">
        {searchServices.map((item) => item.shortcut && (
            <a
                class={`ui ${item.shortcut.style} label${item.shortcut.show ? '' : ' hidden'}`}
                data-search-service-id={item.id}
                data-tooltip={item.name}
                data-variation="mini basic"
                data-position="top center"
                data-inverted=""
            >
                <i class={`${item.shortcut.icon} fitted icon`}></i>
            </a>
        ))}
    </div>
    <div class="ui inverted fluid right action input" id="search-div">
        <input id="search-query" type="text" placeholder="立即搜索" autofocus="autofocus" />
        <select id="search-services" class="ui compact selection dropdown">
            {searchServices.map((item) => (
                <option
                    id={item.id}
                    value={item.id}
                    data-url={item.url}
                    data-transcode={item.transcode ? 'true' : 'false'}
                    data-transcode-from={item.transcode?.from}
                    data-transcode-to={item.transcode?.to}
                >
                    {item.name}
                </option>
            ))}
        </select>
        <div id="search-button" class="ui black icon button"><i class="search icon"></i></div>
    </div>
    <div id="badges">
        <a id="github-star" href={`${site.repositoryUrl}/stargazers`} target="_blank"><img src={`https://img.shields.io/github/stars/${site.repository}?style=social`} alt="GitHub Stargazers" /></a>
        <a id="github-fork" href={`${site.repositoryUrl}/network/members`} target="_blank"><img src={`https://img.shields.io/github/forks/${site.repository}?style=social`} alt="GitHub Forks" /></a>
        <a id="build-time" href={`${site.repositoryUrl}/commits`} target="_blank"><img src="https://img.shields.io/badge/%E6%9E%84%E5%BB%BA%E4%BA%8E-loading-orange?logo=astro" alt="Build Time" /></a>
        <a id="today-visitors" href="/analytics/"><img src="https://img.shields.io/badge/%E4%BB%8A%E6%97%A5%E8%AE%BF%E5%AE%A2-loading-orange?logo=matomo" alt="Today Visitors" /></a>
        <a id="live-visitors" href="/analytics/"><img src="https://img.shields.io/badge/%E5%BD%93%E5%89%8D%E5%9C%A8%E7%BA%BF-loading-orange?logo=matomo" alt="Live Visitors" /></a>
    </div>
    <div class="ui inverted selection link list">
        <a class="item" href="/donate/">请为辛苦的开发者众筹一杯星冰乐</a>
    </div>
    <div class="ui mini black label"><i class="globe icon"></i>支持 IPv6 访问</div>
</div>
