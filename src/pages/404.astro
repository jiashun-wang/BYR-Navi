---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout activeKey="error" title="404" icon="frown">
    <div class="ui vertical stripe segment">
        <div class="ui center aligned text container">
            <h1 class="ui error header">404</h1>
            <h2>啊咧？页面不存在喏！(&gt;_&lt;)</h2>
            <a class="ui basic button" href="/"><i class="arrow left icon"></i>回到首页</a>
        </div>
    </div>
</BaseLayout>
